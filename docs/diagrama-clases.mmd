classDiagram
    direction TB

    class Festival {
        -long id
        -String nombre
        -String temporada
        -LocalDate fechaInicio
        -LocalDate fechaFin
        -float costoPorSuperficie
        -float costoPorMontaje
        -float plusUsoElectricidad
        -float sueldoBase
        -List~UnidadVenta~ lstUnidadVenta
    }

    class Personal {
        <<abstract>>
        -int EDAD_MINIMA$
        -long id
        -String nombre
        -String apellido
        -int dni
        -LocalDate fechaNacimiento
        -LocalDate fechaIngreso
        -float sueldoBase
        -boolean eliminado
        -UnidadVenta unidadVenta
        -User user
        -validarMayoriaDeEdad() void
    }
    class Cajero {
        -TurnoTrabajo turnoTrabajo
    }
    class Cocinero {
        -String especialidadCulinaria
        -float plus
    }
    class Administrador
    class Responsable
    class TurnoTrabajo {
        <<enumeration>>
        MANIANA
        NOCHE
    }

    class User {
        -int id
        -String username
        -String password
        -boolean enabled
        -LocalDateTime createdAt
        -LocalDateTime updatedAt
        -Set~UserRole~ userRoles
    }
    class UserRole {
        -int id
        -User user
        -String role
        -LocalDateTime createdAt
        -LocalDateTime updatedAt
    }

    class UnidadVenta {
        <<abstract>>
        -long id
        -String nombreComercial
        -Responsable responsable
        -float superficieM2
        -String codigoUnico
        -Festival festivalAsistio
        -List~Plato~ lstPlatos
        -List~Personal~ lstPersonal
        +getTipo() TipoUnidad*
    }
    class FoodTruck {
        -String patente
        -boolean conexionElectrica
        +getTipo() TipoUnidad
    }
    class PuestoDesarmable {
        -int carpasComponen
        -int tiempoMontaje
        +getTipo() TipoUnidad
    }
    class TipoUnidad {
        <<enumeration>>
        FOOD_TRUCK
        PUESTO_DESARMABLE
        -String descripcion
        +getDescripcion() String
    }

    class Plato {
        -long id
        -String nombre
        -float precioVenta
        -float costoProduccion
    }
    class Pedido {
        -long id
        -LocalDate fechaTransaccion
        -UnidadVenta unidadVenta
        -List~ItemPedido~ lstItems
        +getTotal() double
    }
    class ItemPedido {
        -long id
        -Pedido pedido
        -Plato plato
        -int cantidad
        +getSubtotal() double
    }

    Personal <|-- Cajero
    Personal <|-- Cocinero
    Personal <|-- Administrador
    Personal <|-- Responsable
    Cajero --> TurnoTrabajo : turnoTrabajo
    Personal "0..1" --> "0..1" User : user
    User "1" -- "0..*" UserRole : userRoles / user

    UnidadVenta <|-- FoodTruck
    UnidadVenta <|-- PuestoDesarmable
    UnidadVenta ..> TipoUnidad : getTipo

    Festival "0..1" -- "0..*" UnidadVenta : lstUnidadVenta / festivalAsistio
    UnidadVenta "0..1" -- "0..*" Personal : lstPersonal / unidadVenta
    UnidadVenta "0..*" --> "0..1" Responsable : responsable
    UnidadVenta "0..*" --> "0..*" Plato : lstPlatos
    Pedido "0..*" --> "1" UnidadVenta : unidadVenta
    Pedido "1" *-- "0..*" ItemPedido : lstItems / pedido
    ItemPedido "0..*" --> "1" Plato : plato
