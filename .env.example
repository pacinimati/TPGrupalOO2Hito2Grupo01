# Copiar este archivo a .env y completar con los datos reales.
# .env NO se sube al repositorio (ver .gitignore).

DB_URL=jdbc:mysql://localhost:3306/tpgrupaloo2hito2grupo01
DB_USERNAME=root
DB_PASSWORD=

# Usuario Administrador que se precarga al iniciar (si ADMIN_PASSWORD esta vacia no se crea)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Servidor SMTP con el que se envia el mail de alta de empleados (usuario y contrasenia generada).
# Con Gmail: MAIL_USERNAME es la casilla y MAIL_PASSWORD una "contrasena de aplicacion"
# (requiere verificacion en dos pasos); no sirve la contrasena normal de la cuenta.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
